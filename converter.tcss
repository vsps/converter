/* converter.tcss — Batch Converter TUI */

Screen {
    background: $c-bg;
}

/* ═══ Splash ══════════════════════════════════════════════ */

SplashScreen {
    align: center middle;
}
#splash-content {
    width: auto;
    height: auto;
    align: center middle;
}
#splash-logo {
    color: $c-accent;
    text-style: bold;
    text-align: center;
    width: auto;
}
#splash-hint {
    color: $c-dim;
    text-align: center;
    width: auto;
    margin-top: 2;
}

/* ── Header ─────────────────────────────────────────── */

#header-bar {
    dock: top;
    height: 3;
    padding: 0 1;
    margin: 0;
    layout: horizontal;
    align: left middle;
}
#header-bar #title {
    color: $c-accent;
    text-style: bold;
    width: auto;
    margin: 0 3 0 0;
}
#header-bar #tool-status {
    color: $c-dim;
    width: auto;
    margin: 0;
}
#header-bar #header-btns {
    dock: right;
    width: auto;
    height: auto;
    align: right middle;
}
#header-bar #settings-btn {
    min-width: 10;
}


/* ── Layout ─────────────────────────────────────────── */

#columns {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}
#col1, #col2, #col3 {
    width: 1fr;
    padding: 0;
}

/* ── Panels ─────────────────────────────────────────── */

.panel,
SettingsScreen .tool-panel,
SettingsScreen .theme-panel,
SettingsScreen .rebuild-panel {
    border: solid $c-border;
    border-title-color: $c-accent;
    border-title-style: bold;
    padding: 0;
}
.panel {
    margin: 0;
}
SettingsScreen .tool-panel,
SettingsScreen .theme-panel,
SettingsScreen .rebuild-panel {
    margin: 0;
}
.panel-label {
    color: $c-dim;
    text-style: bold;
    margin: 0;
}

/* ── Inputs ─────────────────────────────────────────── */

Input, TextArea {
    background: $c-input;
    color: $c-fg;
    border: solid $c-border;
}
Input {
    margin: 0;
}
TextArea {
    height: 8;
}
Input:focus, TextArea:focus {
    border: solid $c-accent;
}

/* ── RadioSet ───────────────────────────────────────── */

RadioSet {
    background: $c-bg;
    border: none;
    height: auto;
    padding: 0;
}
RadioButton {
    background: $c-bg;
    color: $c-fg;
    padding: 0;
}

/* ── Select ─────────────────────────────────────────── */

Select {
    background: $c-input;
    border: solid $c-border;
    margin: 0;
}
Select:focus {
    border: solid $c-accent;
}
SelectOverlay {
    background: $c-input;
    border: solid $c-border;
}
SelectCurrent {
    background: $c-input;
    color: $c-fg;
}

/* ── Checkbox ───────────────────────────────────────── */

Checkbox {
    background: $c-bg;
    color: $c-fg;
    padding: 0;
    height: auto;
    border: none;
}

/* ── Buttons ────────────────────────────────────────── */

Button {
    background: $c-bg;
    color: $c-fg;
    border: solid $c-fg;
    min-width: 8;
    height: 3;
}
Button.primary {
    color: $c-accent;
    border: solid $c-accent;
    text-style: bold;
}
Button.ghost {
    color: $c-dim;
    border: solid $c-dim;
}
Button.danger {
    background: $c-bg;
    color: $c-danger;
    border: solid $c-danger;
}
Button:focus {
    border: solid $c-accent;
}
Button:disabled {
    opacity: 40%;
}

/* ── Browse row ─────────────────────────────────────── */

.browse-row {
    layout: horizontal;
    height: auto;
    margin: 0;
}
.browse-row Input {
    width: 1fr;
    margin: 0;
}
.browse-row Button {
    min-width: 6;
    width: 6;
    margin: 0;
    border: solid $c-dim;
}

/* ── ProgressBar ────────────────────────────────────── */

ProgressBar {
    padding: 0;
    margin: 1 0;
    height: 1;
    width: 1fr;
    color: $c-accent;
}
Bar {
    width: 1fr;
}
Bar > .bar--bar {
    color: $c-accent;
    background: $c-border;
}
Bar > .bar--complete {
    color: $c-success;
}

/* ── Utility ────────────────────────────────────────── */

.btn-row {
    layout: horizontal;
    height: auto;
    margin: 0;
}
.btn-row Button {
    margin: 0;
}
#quit-btn {
    margin: 0;
}
#convert-btn {
    color: $c-dim;
    border: solid $c-dim;
    text-style: bold;
}
#status {
    content-align: left middle;
    width: 1fr;
    margin: 0;
}
.sep {
    height: 1;
    background: $c-border;
    margin: 0;
}

/* ── Input panel ────────────────────────────────────── */

#input-panel {
	height: auto;
}

/* ── Presets ────────────────────────────────────────── */

#format-panel {
    height: auto;
}
#preset-panel {
    height: 1fr;
}
#preset-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}
.preset-group-hdr {
    color: $c-dim;
    text-style: bold;
    margin-top: 0;
    padding: 0;
}
#preset-img-row,
#preset-vid-row {
    height: auto;
    width: 1fr;
}
#preset-img-row Button,
#preset-vid-row Button {
    width: 1fr;
    min-width: 30;
    margin: 0;
    height: 1;
    border: none;
    background: $c-input;
    color: $c-fg;
}

/* ── Save preset row ────────────────────────────────── */

#save-preset-row {
    layout: horizontal;
    height: auto;
    margin-top: 0;
}
#save-preset-row Input {
    width: 1fr;
    margin-bottom: 0;
    border-title-color: $c-accent;
    border-title-style: bold;
}
#save-preset-row Button {
    margin-left: 0;
    min-width: 6;
}

#save-preset-btn {
	    color: $c-dim;
	    border: solid $c-dim;
}
#del-preset-btn {
	    color: $c-danger;
	    border: solid $c-danger;
}

/* ── Output template ────────────────────────────────── */

#output-template {
    margin: 0;
}
#token-btns {
    height: auto;
    margin: 0;
}
#token-btns Horizontal {
    height: 1;
    width: 1fr;
}
Button.token {
    background: $c-bg;
    color: $c-accent;
    border: none;
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
}

/* ── Inline status labels ───────────────────────────── */

#fmt-badge, #name-preview {
    color: $c-dim;
    height: 1;
}
#status {
    color: $c-dim;
}
#fmt-badge {
	margin: 1 0;
}

#name-preview, #status {
	margin: 1 1;
	}

/* ── Log area ───────────────────────────────────────── */

#log-area {
    dock: bottom;
    height: auto;
    max-height: 50%;
    padding: 0;
}
#log-bar {
    layout: horizontal;
    height: 1;
    margin: 0;
}
#log-bar #log-label {
    color: $c-dim;
    text-style: bold;
    width: auto;
}
#log-bar #summary {
    color: $c-dim;
    width: 1fr;
    margin: 0;
}
#log-bar #clear-btn {
    dock: right;
    min-width: 6;
    height: 1;
    border: none;
}
#cmd-preview {
    height: 1;
    padding: 0;
    color: $c-dim;
    margin: 0;
}
RichLog {
    background: $c-bg;
    border: solid $c-border;
    height: 20;
    margin: 0;
    scrollbar-size: 1 1;
}
#args-btn {
    width: 1fr;
    color: $c-dim;
    border: solid $c-dim;
}

/* ═══ Settings Screen ═══════════════════════════════════ */

SettingsScreen {
    layout: vertical;
    height: 100%;
}
SettingsScreen #settings-title {
    color: $c-accent;
    text-style: bold;
    margin: 0;
}
SettingsScreen #settings-scroll {
    height: 1fr;
    padding: 0;
    margin: 0;
}
SettingsScreen #settings-columns {
    layout: horizontal;
    height: auto;
    width: 1fr;
}
SettingsScreen #settings-col-left,
SettingsScreen #settings-col-right {
    width: 1fr;
    padding: 0;
}
SettingsScreen .tool-panel .tool-hint,
SettingsScreen .tool-panel .tool-status,
SettingsScreen .rebuild-panel .rebuild-status {
    color: $c-dim;
}
SettingsScreen .tool-panel .tool-status {
    width: auto;
    margin: 0;
}
SettingsScreen .tool-panel .tool-row {
    layout: horizontal;
    height: auto;
    margin: 0;
}
SettingsScreen .tool-panel .tool-row Input {
    width: 1fr;
}
SettingsScreen .rebuild-panel .rebuild-status {
    margin: 0;
}
SettingsScreen .theme-color-row {
    layout: horizontal;
    height: auto;
    margin: 0;
}
SettingsScreen .theme-color-row Input {
    width: 1fr;
}
SettingsScreen .section-label {
    color: $c-dim;
    text-style: bold;
    margin: 0;
}
SettingsScreen .theme-key {
    color: $c-dim;
    text-style: bold;
    width: 10;
    content-align: left middle;
    margin: 1 0 0 0;
}
SettingsScreen #settings-footer {
    layout: horizontal;
    height: auto;
    margin: 0;
}

/* ═══ Args Reference Screen ═════════════════════════════ */

ArgsReferenceScreen {
    layout: vertical;
    overflow: hidden hidden;
}
ArgsReferenceScreen TabbedContent {
    height: 1fr;
}
ArgsReferenceScreen #args-ref-header {
    layout: horizontal;
    height: auto;
    padding: 0;
}
ArgsReferenceScreen #args-ref-title {
    color: $c-accent;
    text-style: bold;
    width: auto;
}
ArgsReferenceScreen #args-ref-info {
    color: $c-dim;
    width: auto;
    margin: 0;
}
ArgsReferenceScreen #args-ref-footer {
    dock: bottom;
    layout: horizontal;
    height: auto;
    margin: 0;
}
ArgsReferenceScreen #search-bar {
    layout: horizontal;
    height: auto;
    padding: 0;
    margin: 0;
}
ArgsReferenceScreen #search-bar Input {
    width: 1fr;
}
ArgsReferenceScreen #search-bar #search-count {
    color: $c-dim;
    width: auto;
    margin: 0;
    content-align: right middle;
}
ArgsReferenceScreen ContentSwitcher {
    height: 1fr;
}
ArgsReferenceScreen TabPane {
    padding: 0;
}
.arg-row {
    layout: horizontal;
    height: auto;
    padding: 0;
    background: $c-bg;
    margin: 0;
}
.arg-row .arg-flag {
    color: $c-accent;
    text-style: bold;
    width: 28;
}
.arg-row .arg-desc {
    color: $c-fg;
    width: 1fr;
}
.arg-row .arg-last {
    color: $c-dim;
    width: auto;
}
.section-hdr {
    color: $c-accent;
    text-style: bold;
    padding: 0;
    margin: 0;
}

/* ═══ ArgValue Modal ════════════════════════════════════ */

ArgValueModal {
    align: center middle;
}
#arg-value-dialog {
    background: $c-bg;
    border: solid $c-border;
    padding: 0;
    width: 60;
    height: auto;
    max-height: 20;
}
#arg-value-dialog #av-flag {
    color: $c-accent;
    text-style: bold;
}
#arg-value-dialog #av-hint,
#arg-value-dialog #av-desc,
#arg-value-dialog #av-last {
    color: $c-dim;
}
#arg-value-dialog #av-desc,
#arg-value-dialog #av-last {
    margin: 0;
}
#arg-value-dialog .btn-row {
    margin: 0;
}

/* ═══ Browse Screen ═════════════════════════════════════ */

BrowseScreen #browse-header {
    layout: horizontal;
    height: auto;
    padding: 0;
}
BrowseScreen #browse-title {
    color: $c-accent;
    text-style: bold;
    width: auto;
}
BrowseScreen #browse-close-btn {
    dock: right;
    color: white;
    min-width: 5;
}
BrowseScreen #browse-path {
    layout: horizontal;
    padding: 0;
    margin: 0;
    height: auto;
}
BrowseScreen #browse-path Input {
    width: 1fr;
    margin: 0;
}
BrowseScreen #browse-go-btn {
    min-width: 5;
    margin: 0;
}
BrowseScreen DirectoryTree {
    height: 1fr;
    margin: 0;
    border: solid $c-border;
    scrollbar-size: 1 1;
}
BrowseScreen #browse-footer {
    layout: horizontal;
    height: auto;
    margin: 0;
}
