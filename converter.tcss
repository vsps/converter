/* converter.tcss — dark theme for Batch Converter TUI */

$c-bg: #0f0f0f;
$c-panel: #1a1a1a;
$c-panel-hv: #252525;
$c-border: #2a2a2a;
$c-accent: #e8ff47;
$c-muted: #555555;
$c-fg: #e0e0e0;
$c-fg-dim: #888888;
$c-danger: #ff4d4d;
$c-success: #47ffb0;

Screen {
    background: $c-bg;
}

/* ═══ Splash Screen ═════════════════════════════════════ */

SplashScreen {
    background: $c-bg;
    align: center middle;
}
#splash-content {
    width: auto;
    height: auto;
    align: center middle;
}
#splash-logo {
    color: $c-accent;
    text-style: bold;
    text-align: center;
    width: auto;
}
#splash-hint {
    color: $c-muted;
    text-align: center;
    width: auto;
    margin-top: 2;
}

/* ── Header ─────────────────────────────────────────── */

#header-bar {
    dock: top;
    height: 1;
    background: $c-bg;
    padding: 0 2;
    layout: horizontal;
}
#header-bar #title {
    color: $c-accent;
    text-style: bold;
    width: auto;
}
#header-bar #tool-status {
    color: $c-fg-dim;
    width: auto;
    margin-left: 2;
}
#header-bar #settings-btn {
    dock: right;
    min-width: 10;
    background: $c-bg;
    color: $c-fg-dim;
}

/* ── Three-column layout ────────────────────────────── */

#columns {
    layout: horizontal;
    height: 1fr;
    padding: 1 2 0 2;
}
#col1, #col2, #col3 {
    width: 1fr;
    padding: 0 1;
}

/* ── Panel styling ──────────────────────────────────── */

.panel {
    background: $c-panel;
    border: solid $c-border;
    border-title-color: $c-accent;
    border-title-style: bold;
    padding: 1 2;
    margin-bottom: 1;
}
.panel-label {
    color: $c-muted;
    text-style: bold;
    margin-bottom: 1;
}

/* ── Inputs ─────────────────────────────────────────── */

Input {
    background: $c-bg;
    color: $c-fg;
    border: tall $c-border;
    margin-bottom: 1;
}
Input:focus {
    border: tall $c-accent;
}

TextArea {
    background: $c-bg;
    color: $c-fg;
    border: tall $c-border;
    height: 4;
}
TextArea:focus {
    border: tall $c-accent;
}

/* ── RadioSet ───────────────────────────────────────── */

RadioSet {
    background: $c-panel;
    border: none;
    height: auto;
    padding: 0;
}
RadioButton {
    background: $c-panel;
    color: $c-fg;
    padding: 0;
}
RadioButton:hover {
    background: $c-panel-hv;
}

/* ── Select ─────────────────────────────────────────── */

Select {
    background: $c-bg;
    border: tall $c-border;
    margin-bottom: 1;
}
Select:focus {
    border: tall $c-accent;
}
SelectOverlay {
    background: $c-panel;
    border: tall $c-border;
}
SelectCurrent {
    background: $c-bg;
    color: $c-fg;
}

/* ── Checkbox ───────────────────────────────────────── */

Checkbox {
    background: $c-panel;
    color: $c-fg;
    padding: 0;
    height: auto;
    border: none;
}
Checkbox:hover {
    background: $c-panel-hv;
}

/* ── Buttons ────────────────────────────────────────── */

Button {
    background: $c-border;
    color: $c-fg;
    border: none;
    min-width: 8;
    height: 3;
}
Button:hover {
    background: $c-panel-hv;
}
Button.primary {
    background: $c-accent;
    color: $c-bg;
    text-style: bold;
}
Button.primary:hover {
    background: $c-accent;
    color: $c-bg;
}
Button.ghost {
    background: $c-bg;
    color: $c-fg-dim;
}
Button.ghost:hover {
    background: $c-panel;
}
Button.danger {
    background: $c-danger;
    color: $c-bg;
}
Button:disabled {
    opacity: 40%;
}

/* ── Browse buttons ─────────────────────────────────── */

.browse-row {
    layout: horizontal;
    height: auto;
    margin: 1;
}
.browse-row Input {
    width: 1fr;
    margin-bottom: 0;
}
.browse-row Button {
    min-width: 4;
    width: 4;
    margin-left: 1;
}

/* ── ProgressBar ────────────────────────────────────── */

ProgressBar {
    padding: 0;
    margin: 1 0;
    height: 1;
    width: 1fr;
    color: $c-accent;
}
Bar {
    width: 1fr;
}
Bar > .bar--bar {
    color: $c-accent;
    background: $c-border;
}
Bar > .bar--complete {
    color: $c-success;
}

/* ── Button rows ────────────────────────────────────── */

.btn-row {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}
.btn-row Button {
    margin-right: 1;
}
#quit-btn {
    dock: right;
    margin-right: 0;
}
/* ── Input ────────────────────────────────────────── */

#input-panel {
	height: auto;
}

/* ── Presets ────────────────────────────────────────── */

#format-panel {
    height: auto;
}
#preset-panel {
    height: 1fr;
}
#preset-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}
.preset-group-hdr {
    color: $c-muted;
    text-style: bold;
    margin-top: 1;
    padding: 0 1;
}
#preset-img-row,
#preset-vid-row {
    height: auto;
    width: 1fr;
}
#preset-img-row Button,
#preset-vid-row Button {
    width: 1fr;
    min-width: 30;
    margin: 1;
    height: 1;
    background: $c-border;
    color: $c-fg;
}

/* ── Save preset row ────────────────────────────────── */

#save-preset-row {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}
#save-preset-row Input {
    width: 1fr;
    margin-bottom: 0;
}
#save-preset-row Button {
    margin-left: 1;
    min-width: 6;
}

/* ── Output template ────────────────────────────────── */

#output-template {
    margin-bottom: 0;
}
#token-btns {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}
#token-btns Horizontal {
    height: 1;
    width: 1fr;
}
Button.token {
    background: $c-bg;
    color: $c-accent;
    border: none;
    width: auto;
    min-width: 0;
    height: 1;
    margin-right: 1;
}

/* ── Format badge ───────────────────────────────────── */

#fmt-badge {
    color: $c-fg-dim;
    height: 1;
    margin-bottom: 1;
}

/* ── Name preview ───────────────────────────────────── */

#name-preview {
    color: $c-fg-dim;
    height: 1;
    margin-top: 1;
}

/* ── Status ─────────────────────────────────────────── */

#status {
    color: $c-fg-dim;
    height: 1;
    margin-top: 1;
}

/* ── Log area ───────────────────────────────────────── */

#log-area {
    dock: bottom;
    height: auto;
    max-height: 50%;
    padding: 0 2;
}
#log-bar {
    layout: horizontal;
    height: 1;
    margin-top: 1;
}
#log-bar #log-label {
    color: $c-muted;
    text-style: bold;
    width: auto;
}
#log-bar #summary {
    color: $c-fg-dim;
    width: 1fr;
    margin-left: 2;
}
#log-bar #clear-btn {
    dock: right;
    min-width: 6;
}

#cmd-preview {
    height: 1;
    padding: 0 2;
    color: $c-fg-dim;
    margin-top: 1;
}

RichLog {
    background: $c-panel;
    border: solid $c-border;
    height: 25;
    margin-top: 1;
    margin-bottom: 1;
    scrollbar-size: 1 1;
}

/* ── Separator ──────────────────────────────────────── */

.sep {
    height: 1;
    background: $c-border;
    margin: 1 0;
}

/* ── Args button ────────────────────────────────────── */

#args-btn {
    min-width: 6;
    background: $c-border;
    color: $c-accent;
    border: none;
}

/* ═══ Settings Screen ═══════════════════════════════════ */

SettingsScreen {
    background: $c-bg;
}
SettingsScreen #settings-title {
    color: $c-accent;
    text-style: bold;
    margin: 1 2;
}
SettingsScreen .tool-panel {
    background: $c-panel;
    border: solid $c-border;
    border-title-color: $c-accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 2 1 2;
}
SettingsScreen .tool-panel .tool-hint {
    color: $c-muted;
}
SettingsScreen .tool-panel .tool-row {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}
SettingsScreen .tool-panel .tool-row Input {
    width: 1fr;
}
SettingsScreen .tool-panel .tool-status {
    color: $c-fg-dim;
    width: auto;
    margin-left: 1;
}
SettingsScreen .rebuild-panel {
    background: $c-panel;
    border: solid $c-border;
    border-title-color: $c-accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 2 1 2;
}
SettingsScreen .rebuild-panel .rebuild-status {
    color: $c-fg-dim;
    margin-top: 1;
}
SettingsScreen #settings-footer {
    layout: horizontal;
    height: auto;
    margin: 1 2;
}

/* ═══ Args Reference Screen ═════════════════════════════ */

ArgsReferenceScreen {
    background: $c-bg;
    layout: vertical;
    overflow: hidden hidden;
}
ArgsReferenceScreen TabbedContent {
    height: 1fr;
}
ArgsReferenceScreen #args-ref-header {
    layout: horizontal;
    height: auto;
    padding: 1 2;
}
ArgsReferenceScreen #args-ref-title {
    color: $c-accent;
    text-style: bold;
    width: auto;
}
ArgsReferenceScreen #args-ref-info {
    color: $c-fg-dim;
    width: auto;
    margin-left: 2;
}
ArgsReferenceScreen #args-ref-footer {
    dock: bottom;
    layout: horizontal;
    height: auto;
    margin: 1 2;
}
ArgsReferenceScreen #search-bar {
    layout: horizontal;
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
}
ArgsReferenceScreen #search-bar Input {
    width: 1fr;
}
ArgsReferenceScreen #search-bar #search-count {
    color: $c-fg-dim;
    width: auto;
    margin-left: 1;
    content-align: right middle;
}

ArgsReferenceScreen ContentSwitcher {
    height: 1fr;
}
ArgsReferenceScreen TabPane {
    padding: 0;
}

.arg-row {
    layout: horizontal;
    height: auto;
    padding: 0 2;
    background: $c-panel;
    margin: 0 2;
}
.arg-row:hover {
    background: $c-panel-hv;
}
.arg-row .arg-flag {
    color: $c-accent;
    text-style: bold;
    width: 28;
}
.arg-row .arg-desc {
    color: $c-fg;
    width: 1fr;
}
.arg-row .arg-last {
    color: $c-muted;
    width: auto;
}

.section-hdr {
    color: $c-accent;
    text-style: bold;
    padding: 1 2;
    margin-top: 1;
}

/* ═══ ArgValue Modal ════════════════════════════════════ */

ArgValueModal {
    align: center middle;
}
#arg-value-dialog {
    background: $c-panel;
    border: solid $c-border;
    padding: 1 2;
    width: 60;
    height: auto;
    max-height: 20;
}
#arg-value-dialog #av-flag {
    color: $c-accent;
    text-style: bold;
}
#arg-value-dialog #av-hint {
    color: $c-fg-dim;
}
#arg-value-dialog #av-desc {
    color: $c-fg-dim;
    margin-bottom: 1;
}
#arg-value-dialog #av-last {
    color: $c-muted;
    margin-bottom: 1;
}
#arg-value-dialog .btn-row {
    margin-top: 1;
}

/* ═══ Browse Screen ═════════════════════════════════════ */

BrowseScreen {
    background: $c-bg;
}
BrowseScreen #browse-header {
    layout: horizontal;
    height: auto;
    padding: 1 2;
}
BrowseScreen #browse-title {
    color: $c-accent;
    text-style: bold;
    width: auto;
}
BrowseScreen #browse-close-btn {
    dock: right;
    color: white;
    min-width: 5;
}
BrowseScreen #browse-path {
    layout: horizontal;
    padding: 0 2;
    margin-bottom: 1;
    height: auto;
}
BrowseScreen #browse-path Input {
    width: 1fr;
    margin-bottom: 0;
}
BrowseScreen #browse-go-btn {
    min-width: 5;
    margin-left: 1;
}
BrowseScreen DirectoryTree {
    height: 1fr;
    margin: 0 2;
    background: $c-panel;
    border: solid $c-border;
    scrollbar-size: 1 1;
}
BrowseScreen #browse-footer {
    layout: horizontal;
    height: auto;
    margin: 1 2;
}
